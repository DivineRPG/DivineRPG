{
  "default_block": "divinerpg:twilight_stone",
  "default_fluid": "minecraft:water",
  "disable_mob_generation": false,
  "legacy_random_source": false,
  "material_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "add_surface_depth": false,
          "offset": 0,
          "secondary_depth_range": 0,
          "surface_type": "floor"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "divinerpg:wildwood_grass"
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "add_surface_depth": true,
          "offset": 1,
          "secondary_depth_range": 0,
          "surface_type": "floor"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "divinerpg:wildwood_dirt"
        }
      }
    ]
  },
  "noise": {
    "height": 256,
    "min_y": 0
  },
  "noise_router": {
    "chunk_surface_level": 0.0,
    "continents": "minecraft:overworld/continents",
    "depth": "minecraft:overworld/depth",
    "erosion": "minecraft:overworld/erosion",
    "final_density": {
      "type": "minecraft:interpolated",
      "cell_size_xz": 4,
      "cell_size_y": 1,
      "input": {
        "type": "minecraft:add",
        "left": {
          "type": "minecraft:gradient",
          "axis": "y",
          "from_coordinate": 0,
          "from_value": -1.0,
          "to_coordinate": 128,
          "to_value": 0.0
        },
        "right": {
          "type": "minecraft:add",
          "left": {
            "type": "minecraft:gradient",
            "axis": "y",
            "from_coordinate": 128,
            "from_value": 0.0,
            "to_coordinate": 256,
            "to_value": -1.0
          },
          "right": "minecraft:overworld/base_3d_noise"
        }
      }
    },
    "ridges": "minecraft:overworld/ridges",
    "temperature": 0.6,
    "vegetation": {
      "type": "minecraft:noise",
      "noise": "minecraft:vegetation_large",
      "shift_x": "minecraft:shift_x",
      "shift_z": "minecraft:shift_z",
      "xz_scale": 0.25,
      "y_scale": 0.0
    }
  },
  "sea_level": 0,
  "spawn_target": []
}