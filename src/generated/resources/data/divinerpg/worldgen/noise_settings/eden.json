                        "type": "minecraft:stone_depth",
                        "add_surface_depth": false,
                        "offset": 0,
                        "secondary_depth_range": 0,
                        "surface_type": "floor"
                      },
                      "then_run": {
                        "type": "minecraft:block",
                        "result_state": "divinerpg:ray_grass"
                      }
                    },
                    {
                      "type": "minecraft:block",
                      "result_state": "divinerpg:ray_dirt"
                    }
                  ]
                }
              },
              {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:stone_depth",
                  "add_surface_depth": false,
                  "offset": 0,
                  "secondary_depth_range": 0,
                  "surface_type": "floor"
                },
                "then_run": {
                  "type": "minecraft:block",
                  "result_state": "divinerpg:scorched_dirt"
                }
              },
              {
                "type": "minecraft:block",
                "result_state": "divinerpg:scorched_dirt"
              }
            ]
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "divinerpg:eden/golden_peaks"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "divinerpg:ray_stone"
