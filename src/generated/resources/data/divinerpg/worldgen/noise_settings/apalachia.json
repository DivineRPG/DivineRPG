            "from_value": 0.0,
            "from_y": 128,
            "to_value": -0.7,
            "to_y": 256
          },
          "argument2": "minecraft:end/base_3d_noise"
        }
      }
    },
    "fluid_level_floodedness": 0.0,
    "fluid_level_spread": 0.0,
    "lava": 0.0,
    "preliminary_surface_level": "minecraft:overworld/base_3d_noise",
    "ridges": "minecraft:overworld/ridges",
    "temperature": 0.6,
    "vegetation": {
